    write_style(&mut xml, "Normal", "Normal", true, None)?;
    write_style(
        &mut xml,
        "ListParagraph",
        "List Paragraph",
        false,
        Some("Normal"),
    )?;
    let spacing = [
        (360, 240),
        (320, 160),
        (280, 120),
        (240, 120),
        (220, 100),
        (200, 100),
    ];
    for level in 1..=6 {
        let size = heading_size(level);
        let (before, after) = spacing[usize::from(level - 1)];
        let named = format!("Heading{level}");
        let display = format!("Heading {level}");
        let numeric = level.to_string();
        write_heading_style(
            &mut xml,
            &named,
            &display,
            size,
            before,
            after,
            level - 1,
            style,
        )?;
        write_heading_style(
            &mut xml,
            &numeric,
            &display,
            size,
            before,
            after,
            level - 1,
            style,
        )?;
    }
    write_footnote_reference_style(&mut xml)?;
    write_toc_heading_style(&mut xml)?;
    write_style(&mut xml, "Caption", "Caption", false, Some("Normal"))?;
    xml.end("w:styles")?;
    Ok(xml.finish())
}

fn write_style(
    xml: &mut Xml,
