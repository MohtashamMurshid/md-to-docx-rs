    #[test]
    fn set_metadata_rewrites_core_app_and_custom() {
        use std::collections::BTreeMap;

        use crate::convert::convert_with_options;
        use crate::options::{ConvertOptions, DocumentMetadata};

        let bytes = convert_with_options(
            "# Report",
            &ConvertOptions {
