            callout: block
                .callout
                .as_ref()
                .map(copy_callout)
                .or_else(|| parent.and_then(|quote| quote.callout.as_ref().map(copy_callout))),
            italic_paragraphs: block.callout.is_none(),
        };
        if block.callout.is_some() {
